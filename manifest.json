{
  "manifest_version": 3,
  "name": "Custom Dynamic Dashboard",
  "version": "1.7.0",
  "description": "Dashboard para a página inicial com repositórios Git e domínios mais acessados no período escolhido.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "favicon",
    "history",
    "storage",
    "unlimitedStorage"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Abrir o painel com o foco na busca"
    }
  }
}
